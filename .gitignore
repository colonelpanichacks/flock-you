
# PlatformIO build artifacts
.pio/

# Auto-generated by pioarduino/platform-espressif32's Arduino-ESP32 3.x
# component manager during build (ESP-IDF component manifest requirement) —
# regenerated every build, not real project configuration.
idf_component.yml
idf_component.yml.orig

# platformio-mcp tool workspace (build logs, task registry, audit trail)
.pio-mcp-workspace/

# IDE settings
.vscode/


# macOS junk
.DS_Store

# SPIFFS runtime session files (written by firmware to the ESP32 filesystem,
# never source-controlled — they contain field detection data)
session.json
session.tmp
prev_session.json
